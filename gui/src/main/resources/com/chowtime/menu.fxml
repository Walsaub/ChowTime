<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chowtime.controllers.MenuController"
      spacing="12"
      prefHeight="700" prefWidth="1000">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Food Selection"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label fx:id="tableInfoLabel"
                   text="Table information"/>
        </VBox>

        <Button text="Close Table"
                onAction="#handleCloseTable"
                style="-fx-font-weight: bold;"/>

    </HBox>


    <Label text="Available Food Items"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TabPane fx:id="categoryTabPane"
             tabClosingPolicy="UNAVAILABLE"
             prefHeight="75"/>

    <TableView fx:id="menuTableView" prefHeight="230">
        <columns>
            <TableColumn fx:id="itemNameColumn" text="Food Item" prefWidth="200"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="120"/>
            <TableColumn fx:id="allergenColumn" text="Allergens" prefWidth="180"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Quantity:"/>
        <TextField fx:id="quantityField"
                   text="1"
                   prefWidth="70"/>
        <Button text="Add to Order"
                onAction="#handleAddItem"/>
    </HBox>

    <Label text="Current Order"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="cartTableView" prefHeight="180">
        <columns>
            <TableColumn fx:id="cartItemNameColumn" text="Food Item" prefWidth="200"/>
            <TableColumn fx:id="cartQuantityColumn" text="Quantity" prefWidth="120"/>
            <TableColumn fx:id="cartPriceColumn" text="Unit Price" prefWidth="120"/>
            <TableColumn fx:id="cartSubtotalColumn" text="Subtotal" prefWidth="120"/>
            <TableColumn fx:id="cartItemOptionsColumn" text="Customizations" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Remove Selected Item"
                onAction="#handleRemoveItem"/>
        <Button text="Place Order"
                onAction="#handlePlaceOrder"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="requestAssistanceButton"
                text="Request Assistance"
                onAction="#handleRequestAssistance"/>
        <Button fx:id="backToWaiterDashboardButton"
                text="Back to Waiter Dashboard"
                onAction="#handleBackToWaiterDashboard"
                visible="false"
                managed="false"/>
    </HBox>

    <Label fx:id="totalLabel"
           text="Total: $0.00"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label fx:id="messageLabel"
           wrapText="true"/>

</VBox>

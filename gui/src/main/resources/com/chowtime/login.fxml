<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chowtime.controllers.LoginController"
      alignment="CENTER"
      spacing="15"
      prefWidth="420"
      prefHeight="450"
      style="-fx-padding: 35;">

    <Label text="Chow Time"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"
    />

    <Label text="Database Login"
           style="-fx-font-size: 17px;"
    />

    <VBox spacing="7">
        <Label text="Username"/>
        <TextField fx:id="usernameField"
                   promptText="Enter MySQL username"
                   prefHeight="38"
        />
    </VBox>

    <VBox spacing="7">
        <Label text="Password"/>
        <PasswordField fx:id="passwordField"
                       promptText="Enter MySQL password"
                       prefHeight="38"
                       onAction="#handleLogin"
        />
    </VBox>

    <Button fx:id="loginButton"
            text="Connect"
            onAction="#handleLogin"
            prefWidth="100"
            prefHeight="40"
            style="-fx-font-size: 14px;"
    />

    <Label fx:id="statusLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: red;"
    />

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chowtime.controllers.EmployeeLoginController"
      alignment="CENTER"
      spacing="15"
      prefHeight="350"
      prefWidth="400">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Back to Tables"
                onAction="#handleBackToTables"
                maxWidth="150"/>
    </HBox>

    <Label text="Chow Time"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Employee Login"
           style="-fx-font-size: 18px;"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="280"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="280"
                   onAction="#handleLogin"/>

    <Button text="Login"
            onAction="#handleLogin"
            maxWidth="100"
            defaultButton="true"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"/>

</VBox>

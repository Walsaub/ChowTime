<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chowtime.controllers.TableController"
      spacing="15"
      prefHeight="500"
      prefWidth="750">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Employee Login"
                onAction="#handleEmployeeLogin"/>
    </HBox>

    <Label text="Select from the available restaurant tables."/>

    <TableView fx:id="tablesTableView"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tableNumberColumn"
                         text="Table Number"/>
            <TableColumn fx:id="capacityColumn"
                         text="Capacity"/>
            <TableColumn fx:id="statusColumn"
                         text="Status"/>
        </columns>
    </TableView>

    <Label text="Assign a waiter to the selected table"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label fx:id="selectedTableLabel"
           text="No table selected"/>

    <ComboBox fx:id="waiterComboBox"
              promptText="Select a waiter"
              prefWidth="280"/>

    <Button text="Assign Waiter"
            onAction="#handleAssignWaiter"
            maxWidth="280"/>

    <Button text="Refresh Tables"
            onAction="#handleRefresh"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"/>

</VBox>

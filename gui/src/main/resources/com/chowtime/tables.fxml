<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chowtime.controllers.TableController"
      spacing="15"
      prefHeight="500"
      prefWidth="750">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Select from the available restaurant tables."/>

    <TableView fx:id="tablesTableView"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tableNumberColumn"
                         text="Table Number"
                         prefWidth="200"/>
            <TableColumn fx:id="capacityColumn"
                         text="Capacity"
                         prefWidth="200"/>
            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="200"/>
        </columns>
    </TableView>

    <Button text="Refresh Tables"
            onAction="#handleRefresh"/>
    <Label fx:id="messageLabel"
           text=""
           wrapText="true"/>

</VBox>
